# ALC-G Fase 0 — runtime del núcleo apalancado (cuenta paper SEPARADA #2).
# Copiar a `.env.alc-g` (gitignored) y completar con las keys de la 2da cuenta paper.
#
# IMPORTANTE: en Alpaca cada cuenta paper tiene su PROPIO par de API key/secret.
# Estas NO son las del bot (#1). Generarlas en el dashboard de la cuenta #2:
#   Alpaca paper dashboard -> (cuenta #2) -> "View/Generate API Keys".

# Credenciales de la cuenta paper #2 (distintas a las del bot)
ALCG_ALPACA_API_KEY=
ALCG_ALPACA_SECRET_KEY=
ALCG_ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Slider de leverage (humano-en-el-loop). El glide-path por capital es un TECHO
# que el slider nunca supera.
ALCG_LEVERAGE_TARGET=1.5

# Preset de composición (turbo|rendimiento|normal|pasivo). Fase 0 = turbo (0% lastre).
ALCG_PRESET=turbo

# Modo de ejecución: informe (default, NO manda órdenes) | ejecutar (requiere GO Roman).
ALCG_MODE=informe
