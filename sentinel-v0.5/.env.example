ALPACA_API_KEY=tu_api_key_aqui
ALPACA_SECRET_KEY=tu_secret_key_aqui
ALPACA_BASE_URL=https://paper-api.alpaca.markets
DATABASE_URL=postgresql://usuario:password@localhost:5432/sentinel
# DEPRECADO (swap FinBERT→DeepSeek): The Ear ya NO usa NewsAPI — pasó a Alpaca
# News (mismas keys de Alpaca de arriba). Dejar vacío/quitar. Conservado solo por
# compatibilidad; ya no es crítico para el arranque.
NEWS_API_KEY=
SECRET_KEY=genera_un_string_aleatorio_seguro
OWNER_USERNAME=roman
# Email del owner (cuenta ADMIN protegida + reply-to de cierres). PII — real solo en el .env.
OWNER_EMAIL=owner@example.com

# Google OAuth — credenciales del proyecto Google Cloud.
# Crear en https://console.cloud.google.com/apis/credentials
# Authorized redirect URI debe coincidir con OAUTH_REDIRECT_URI.
GOOGLE_CLIENT_ID=tu_client_id_de_google
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google

# SESSION_SECRET firma las cookies de sesión.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=genera_otro_string_aleatorio_seguro
OAUTH_REDIRECT_URI=https://sentinel.afterlifecapital.co/auth/callback

# Resend — emails transaccionales (welcome/removal del panel admin).
# Dominio verificado: afterlifecapital.co. Crear key en https://resend.com/api-keys
RESEND_API_KEY=tu_resend_api_key_aqui

# MASTER_ENCRYPTION_KEY — Fernet key (32 bytes base64 url-safe) usada para
# encriptar las API keys gestionadas desde el panel admin (#FIX-008).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRÍTICO: si se pierde, todas las api_keys persistidas quedan inutilizables.
MASTER_ENCRYPTION_KEY=genera_una_fernet_key_y_pegala_aqui

# Anthropic API — Universe Selector (#UNIVERSE-SELECTION).
# Crear key en https://console.anthropic.com/settings/keys.
# Configurar spend limit en console.anthropic.com (recomendado $10/mes).
ANTHROPIC_API_KEY=sk-ant-...
# Modelo opcional (default: claude-sonnet-4-6, balance capacidad/costo).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Universe Selection toggles (todos opcionales con defaults sensatos).
# UNIVERSE_SELECTION_ENABLED=true
# UNIVERSE_SELECTION_TIMEOUT_SECONDS=30
# UNIVERSE_SELECTION_MAX_COST_PER_CALL_USD=0.20
# UNIVERSE_SELECTION_CYCLE_TIMEOUT_SECONDS=60
# UNIVERSE_SELECTION_CANDIDATE_TTL_DAYS=7

# DeepSeek API — The Ear interpreta las noticias de Alpaca News y devuelve un
# risk_score 0-1 (swap FinBERT→DeepSeek). Crear key en platform.deepseek.com.
# Sin esta key, The Ear queda "sordo" a noticias (risk_score = último conocido);
# NO es crítica para el arranque. API OpenAI-compatible (no requiere SDK extra).
DEEPSEEK_API_KEY=sk-...
# Modelo opcional (default: deepseek-v4-flash, barato y suficiente para clasificar
# densidad risk-off; ~$1-2/mes con título+resumen). Subir a deepseek-v4-pro si se
# quiere más capacidad de juicio (más caro).
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT_SECONDS=20

# Veto de noticias SUAVIZADO (histéresis). Entra al veto con risk_score >= ENTER
# en CONSECUTIVE ciclos seguidos; sale con risk_score < EXIT. El Circuit Breaker
# (freno rápido por precio) es independiente y no se toca.
# RISK_VETO_ENTER_THRESHOLD=0.70
# RISK_VETO_EXIT_THRESHOLD=0.60
# RISK_VETO_CONSECUTIVE_CYCLES=2
# NEWS_BATCH_MAX_ARTICLES=40
# NEWS_TOP_TITLES=5
